# Public app
VITE_SITE_URL=https://rovik.example
VITE_SITE_NAME=ROVIK
VITE_ENABLE_DEMO_MODE=true

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
SUPABASE_PROJECT_ID=your-project-id

# Email notifications via Supabase Edge Function
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
ADMIN_NOTIFICATION_EMAIL=hello@rovik.example
FROM_EMAIL=ROVIK <noreply@rovik.example>

# Optional booking/provider integrations
VITE_CALENDAR_BOOKING_URL=https://cal.com/rovik/discovery
VITE_PLAUSIBLE_DOMAIN=rovik.example

# Havali optional providers. Leave empty to use deterministic/RAG-only mode.
VITE_HAVALI_PROVIDER=hybrid
HAVALI_LLM_ENDPOINT=
HAVALI_LLM_API_KEY=
HAVALI_MODEL_NAME=

# Security
RATE_LIMIT_SECRET=change-me
JWT_SECRET=change-me

# Set true only after deploying supabase/functions/notify and configuring Resend secrets.
VITE_ENABLE_EMAIL_NOTIFICATIONS=false
